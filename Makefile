# csm — portable POSIX make; works with BSD make and GNU make.

.POSIX:

CC = cc
CFLAGS = -std=c11 -Wall -Wextra -pedantic -O2
PREFIX = /usr/local
BINDIR = $(PREFIX)/bin

LIB_SRC = src/cli.c src/debug.c src/field.c src/fileio.c src/format.c \
	src/github.c src/inventory.c src/json.c src/move.c src/msg.c \
	src/path.c src/platform.c src/report.c src/rewrite.c src/screen.c \
	src/session.c src/settings.c src/term.c src/theme.c src/trash.c \
	src/tui.c src/tui_draw.c src/uistate.c src/util.c
LIB_HDR = src/cli.h src/debug.h src/field.h src/fileio.h src/format.h \
	src/github.h src/inventory.h src/json.h src/move.h src/msg.h \
	src/path.h src/platform.h src/report.h src/rewrite.h src/screen.h \
	src/session.h src/settings.h src/term.h src/theme.h src/trash.h \
	src/tui.h src/uistate.h src/util.h
TEXTS = lang/en.txt help/en.txt lang/pl.txt help/pl.txt

all: csm

build/catalog.c: tools/embed.sh $(TEXTS)
	mkdir -p build
	sh tools/embed.sh $(TEXTS) > build/catalog.tmp
	mv build/catalog.tmp build/catalog.c

csm: src/main.c $(LIB_SRC) $(LIB_HDR) build/catalog.c
	$(CC) $(CFLAGS) -Isrc -o csm src/main.c $(LIB_SRC) build/catalog.c

build/unit: tests/unit.c tests/test.h $(LIB_SRC) $(LIB_HDR) build/catalog.c
	mkdir -p build
	$(CC) $(CFLAGS) -Isrc -o build/unit tests/unit.c $(LIB_SRC) \
		build/catalog.c

build/tui: tests/tui.c tests/test.h
	mkdir -p build
	$(CC) $(CFLAGS) -o build/tui tests/tui.c

build/csm-fake-claude: tests/sleeper.c
	mkdir -p build
	$(CC) $(CFLAGS) -o build/csm-fake-claude tests/sleeper.c

# Tests work only below t/test; t/ also holds files that must survive.
test: csm build/unit build/tui build/csm-fake-claude
	rm -rf t/test
	mkdir -p t/test/unit t/test/tui t/test/cli t/test/integration \
		t/test/compat t/test/install
	build/unit t/test/unit
	build/tui ./csm t/test/tui
	sh tests/cli.sh ./csm t/test/cli build/csm-fake-claude
	sh tests/integration.sh ./csm t/test/integration
	sh tests/compat.sh ./csm t/repo-mv.sh t/test/compat
	sh tests/install.sh "$(MAKE)" t/test/install

install: csm
	mkdir -p $(DESTDIR)$(BINDIR)
	cp csm $(DESTDIR)$(BINDIR)/csm
	chmod 755 $(DESTDIR)$(BINDIR)/csm

uninstall:
	rm -f $(DESTDIR)$(BINDIR)/csm

clean:
	rm -rf build csm t/test
